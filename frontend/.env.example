# FastAPIのベースURL。末尾にスラッシュは付けない。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# mock: 固定データ、remote: FastAPIへ接続
NEXT_PUBLIC_API_MODE=mock

# Supabase Auth。Dashboard > Project Settings > API の値を .env.local に設定する。
# anon key はブラウザーへ配布される公開鍵。service role key は絶対にここへ書かない。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
