# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_METHODS=GET,POST,PATCH,OPTIONS
CORS_ALLOW_HEADERS=Accept,Authorization,Content-Type,X-User-ID,X-Request-ID
CORS_ALLOW_CREDENTIALS=false
ALLOWED_HOSTS=localhost,127.0.0.1
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
# Local-only compatibility mode. Production must use AUTH_MODE=jwt.
AUTH_MODE=legacy
AUTH_CACHE_TTL_SECONDS=30

# Supabase project settings. Use the server-only key for backend writes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-key
SUPABASE_SCHEMA=public

# OrcaRouter dashboardで発行したキーを設定してください。
# 実際の値はこのファイルではなく、Git管理対象外の .env にのみ保存します。
ORCAROUTER_API_KEY=sk-orca-your-key-here

# OrcaRouter is OpenAI-compatible. Usually the defaults below do not need changes.
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=orcarouter/auto
ORCAROUTER_TIMEOUT_SECONDS=30
