# OrcaRouter dashboardで発行したキーを設定してください。
# 実際の値はこのファイルではなく、Git管理対象外の .env にのみ保存します。
ORCAROUTER_API_KEY=sk-orca-your-key-here

# OrcaRouter is OpenAI-compatible. Usually the defaults below do not need changes.
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=orcarouter/auto
ORCAROUTER_TIMEOUT_SECONDS=30
